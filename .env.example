# Dedicated paper account only. Never commit real values.
ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me
ALPACA_ACCOUNT_NUMBER=replace_me
ALPACA_INITIAL_EQUITY=100000
ALPACA_OPTIONS_LEVEL=3

FEATHERLESS_API_KEY=replace_me

# Keep NO for shadow/read-only operation. Order-enabled runs additionally
# require the explicit --enable-orders command-line flag.
TOURNAMENT_ENABLE_ORDERS=NO
